{
  "name": "coach-backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test --preload ./tests/setup.ts tests",
    "test:unit": "bun test --preload ./tests/setup.ts tests/contracts.test.ts tests/coaching-behavior.test.ts tests/session-crypto.test.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.core.json --pretty false",
    "worker": "bun run src/worker.ts",
    "contracts": "bun run scripts/generate-contracts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "precommit": "lint-staged && bun run format:check && bun run lint && bun run typecheck && bun run test:unit"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.947.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "arctic": "^3.7.0",
    "bullmq": "^5.65.1",
    "crypto-js": "^4.2.0",
    "elysia": "^1.4.30",
    "ioredis": "^5.8.2",
    "jose": "^6.1.0",
    "mongoose": "^8.18.0",
    "ws": "8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/ws": "8.18.1",
    "bun-types": "latest",
    "openapi-typescript": "7.13.0",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.48.0",
    "typescript": "5.9.3"
  },
  "module": "src/index.ts"
}
